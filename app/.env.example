# ─────────────────────────────────────────
# app/.env - アプリ直接起動時 / シードスクリプト用
# このファイルをコピーして .env を作成してください
#   cp app/.env.example app/.env
#
# ※ Docker Compose で起動する場合、DATABASE_URL・AUTH_SECRET・AUTH_URL は
#    docker-compose.yml と ルートの .env で管理されます。
#    このファイルはローカルで直接 Next.js を起動する場合や、
#    コンテナ外でスクリプトを実行する場合に使用します。
# ─────────────────────────────────────────

# データベース接続URL
# Docker Compose 使用時: コンテナ内では docker-compose.yml の値が優先されます
DATABASE_URL="postgresql://devtraining:devtraining@localhost:5432/devtraining"

# 認証トークンの署名に使う秘密鍵（openssl rand -base64 32 で生成）
AUTH_SECRET="change-me-use-openssl-rand-base64-32"

# アプリにアクセスするURL
AUTH_URL="http://localhost:3001"
