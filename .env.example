# ─────────────────────────────────────────
# Docker Compose で使用する環境変数
# このファイルをコピーして .env を作成してください
#   cp .env.example .env
# ─────────────────────────────────────────

# COMPOSE_FILE: 使用する docker-compose ファイル
#   ローカル開発: docker-compose.yml（デフォルト）
#   本番環境:     docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml

# ─────────────────────────────────────────
# 共通設定
# ─────────────────────────────────────────

# AUTH_SECRET: 認証トークンの署名に使う秘密鍵
#   生成コマンド: openssl rand -base64 32
AUTH_SECRET=change-me-use-openssl-rand-base64-32

# AUTH_URL: アプリにアクセスするURL
#   ローカル開発: http://localhost:3001
#   本番環境:     https://<本番ドメイン>
AUTH_URL=http://localhost:3001

# ─────────────────────────────────────────
# AWS Bedrock（AI採点機能）
# ─────────────────────────────────────────

# AWS_REGION: Bedrockを利用するリージョン
AWS_REGION=ap-northeast-1

# BEDROCK_MODEL_ID: 使用するモデルID
#   例: jp.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# ─────────────────────────────────────────
# 本番環境のみ（COMPOSE_FILE=docker-compose.prod.yml 時）
# ─────────────────────────────────────────

# POSTGRES_USER=devtraining
# POSTGRES_PASSWORD=<強固なパスワードを設定>
# POSTGRES_DB=devtraining

# DB_DATA_PATH: PostgreSQLデータの保存先（ホスト側パス）
#   デフォルト: ./data/postgres
# DB_DATA_PATH=/var/data/postgres
