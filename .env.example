# ─────────────────────────────────────────
# Docker Compose で使用する環境変数
# このファイルをコピーして .env を作成してください
#   cp .env.example .env
# ─────────────────────────────────────────

# AUTH_SECRET: 認証トークンの署名に使う秘密鍵
#   生成コマンド: openssl rand -base64 32
AUTH_SECRET=change-me-use-openssl-rand-base64-32

# AUTH_URL: アプリにアクセスするURL（ポートは docker-compose.yml で 3001 にマッピング）
#
# ローカル開発の場合:
AUTH_URL=http://localhost:3001
#
# 検証環境・本番環境の場合（サーバーの IP またはドメインに変更）:
# AUTH_URL=http://192.168.x.x:3001
